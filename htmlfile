<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>JavaScript Fundamentals Assignment</title>

    <!-- Link to external CSS files -->
    <link rel="stylesheet" href="style.css">
    <link rel="stylesheet" href="extra-styles.css"> <!-- Example additional CSS -->

</head>
<body>
    <h1>JavaScript Fundamentals Assignment</h1>

    <!-- Part 1: Variables & Conditionals -->
    <div>
        <h2>Part 1: Variables & Conditionals</h2>
        <input type="number" id="ageInput" placeholder="Enter your age">
        <button id="checkAgeBtn">Check Age</button>
        <p id="ageResult"></p>
    </div>

    <!-- Part 2: Functions -->
    <div>
        <h2>Part 2: Functions</h2>
        <input type="number" id="num1" placeholder="Number 1">
        <input type="number" id="num2" placeholder="Number 2">
        <button id="sumBtn">Calculate Sum</button>
        <p id="sumResult"></p>
    </div>

    <!-- Part 3: Loops -->
    <div>
        <h2>Part 3: Loops</h2>
        <button id="showNumbersBtn">Show Numbers 1-10</button>
        <p id="numbersOutput"></p>
    </div>

    <!-- Part 4: DOM Manipulation -->
    <div>
        <h2>Part 4: DOM Manipulation</h2>
        <button id="changeTextBtn">Change Text</button>
        <button id="toggleColorBtn">Toggle Color</button>
        <button id="addElementBtn">Add New Element</button>
        <p id="domText">This is some text to manipulate.</p>
        <div id="newElementsContainer"></div>
    </div>

    <!-- Link to external JS files -->
    <script src="script.js"></script>
    <script src="extra-functions.js"></script> <!-- Example additional JS file -->
</body>
</html>
